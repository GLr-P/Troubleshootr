<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!--
      A downloaded zip marks every extracted file as "from the internet". .NET Framework then refuses Assembly.LoadFrom
      for those files, which is how the sensor library (lhm\x64 etc.) is loaded. Our own files are trusted like the exe.
    -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>

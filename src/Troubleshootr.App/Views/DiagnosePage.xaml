<UserControl x:Class="Troubleshootr.App.Views.DiagnosePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>
  </UserControl.Resources>
  <ScrollViewer>
    <StackPanel Margin="28,24,28,28">
      <!-- Device header -->
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="{Binding Device.DeviceName, FallbackValue='This PC'}"/>
            <TextBlock Style="{StaticResource Dim}" Margin="0,2,0,0" x:Name="ModelLine"/>
            <TextBlock Style="{StaticResource Dim}" Text="{Binding Device.Windows}"/>
            <TextBlock Style="{StaticResource Dim}" x:Name="SpecLine"/>
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
            <Border x:Name="AdminBadge" CornerRadius="10" Padding="10,4" Background="{DynamicResource WarningSoft}">
              <TextBlock x:Name="AdminText" Foreground="{DynamicResource Warning}" FontSize="12" Text="Not running as admin: some checks are skipped"/>
            </Border>
            <Button x:Name="ElevateButton" Margin="0,8,0,0" HorizontalAlignment="Right" Content="Restart as admin" Click="Elevate_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Scan buttons -->
      <StackPanel Orientation="Horizontal" Margin="0,18,0,12">
        <Button Tag="primary" Padding="22,10" FontSize="14" Click="Quick_Click" IsEnabled="{Binding Idle}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Foreground="{DynamicResource OnAccent}" Text="&#xE721;" Margin="0,0,8,0"/>
            <TextBlock Foreground="{DynamicResource OnAccent}" Text="Quick scan"/>
          </StackPanel>
        </Button>
        <Button Margin="10,0,0,0" Padding="18,10" FontSize="14" Click="Full_Click" IsEnabled="{Binding Idle}" Content="Full scan"
                ToolTip="Also runs the slower checks: event history, network tests, update search"/>
        <Button x:Name="SelectedButton" Margin="10,0,0,0" Padding="18,10" FontSize="14" Click="Selected_Click" Content="Scan selected" IsEnabled="False"/>
        <TextBlock Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="16,0,0,0" Text="{Binding Status}" MaxWidth="460"/>
      </StackPanel>

      <!-- Category tiles -->
      <TextBlock Style="{StaticResource H2}" Text="Or pick what to look at" Margin="0,8,0,10"/>
      <ItemsControl ItemsSource="{Binding Tiles}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ToggleButton Style="{StaticResource Tile}" IsChecked="{Binding Selected, Mode=TwoWay}" Click="Tile_Click" IsEnabled="{Binding Available}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="30"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource Accent}" Text="{Binding Glyph}"/>
                <StackPanel Grid.Column="1">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Label}"/>
                  <TextBlock Style="{StaticResource Dim}" FontSize="11.5" Text="{Binding Hint}"/>
                </StackPanel>
              </Grid>
            </ToggleButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Results -->
      <StackPanel Visibility="{Binding HasReport, Converter={StaticResource Vis}}" Margin="0,14,0,0">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <TextBlock Style="{StaticResource H2}" Text="Results" VerticalAlignment="Center"/>
          <Border CornerRadius="10" Padding="9,2" Margin="14,0,0,0" Background="{DynamicResource CriticalSoft}">
            <TextBlock Foreground="{DynamicResource Critical}" FontSize="12"><Run Text="{Binding Critical, Mode=OneWay}"/> critical</TextBlock>
          </Border>
          <Border CornerRadius="10" Padding="9,2" Margin="6,0,0,0" Background="{DynamicResource WarningSoft}">
            <TextBlock Foreground="{DynamicResource Warning}" FontSize="12"><Run Text="{Binding Warnings, Mode=OneWay}"/> warnings</TextBlock>
          </Border>
          <Border CornerRadius="10" Padding="9,2" Margin="6,0,0,0" Background="{DynamicResource InfoSoft}">
            <TextBlock Foreground="{DynamicResource Info}" FontSize="12"><Run Text="{Binding Infos, Mode=OneWay}"/> notes</TextBlock>
          </Border>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Findings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="Bar" CornerRadius="8,0,0,8"/>
                  <Grid Grid.Column="1" Margin="14,12,16,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="28"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Ico" Style="{StaticResource Icon}" FontSize="16" VerticalAlignment="Top" Margin="0,1,0,0" Text="{Binding Glyph}"/>
                    <StackPanel Grid.Column="1">
                      <Grid>
                        <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding Title}" Margin="0,0,120,0"/>
                        <TextBlock Style="{StaticResource Dim}" FontSize="11.5" HorizontalAlignment="Right" Text="{Binding Meta}"/>
                      </Grid>
                      <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0" Text="{Binding Evidence}"/>
                      <TextBlock Margin="0,6,0,0"><Run FontWeight="SemiBold" Text="What to do: "/><Run Text="{Binding Advice, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Key}" Value="Critical">
                  <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Critical}"/>
                  <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Critical}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="Warning">
                  <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Warning}"/>
                  <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="Info">
                  <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Info}"/>
                  <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Info}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border x:Name="NoProblems" Style="{StaticResource Card}" Background="{DynamicResource OkSoft}" BorderThickness="0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Foreground="{DynamicResource Ok}" FontSize="16" Text="&#xE73E;" Margin="0,0,10,0"/>
            <TextBlock Foreground="{DynamicResource Ok}" Text="No problems found in what was checked."/>
          </StackPanel>
        </Border>
        <Expander x:Name="NotCheckedBox" Margin="0,8,0,0" Foreground="{DynamicResource TextDim}">
          <Expander.Header>
            <TextBlock Style="{StaticResource Dim}" x:Name="NotCheckedHeader"/>
          </Expander.Header>
          <ItemsControl ItemsSource="{Binding NotChecked}" Margin="24,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource Dim}" FontSize="12"><Run Text="{Binding CheckId, Mode=OneWay}"/>: <Run Text="{Binding Reason, Mode=OneWay}"/></TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

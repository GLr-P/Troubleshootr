<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.8.1</Version>
    <Authors>GLr-P</Authors>
    <Product>Troubleshootr</Product>
    <Copyright>Troubleshootr contributors, GPL-3.0</Copyright>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- LibreHardwareMonitorLib ships only per-architecture builds (runtimes/win-x64, win-x86); see Directory.Build.targets. -->
    <LhmVersion>0.9.6</LhmVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- System.Net.Http isn't referenced on net472 by default and nothing here needs it globally. -->
    <Using Remove="System.Net.Http" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'net472'">
    <Compile Include="$(MSBuildThisFileDirectory)build\Polyfills.cs" Link="Polyfills.cs" />
  </ItemGroup>
</Project>
